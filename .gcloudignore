# Files NOT uploaded by `gcloud run deploy --source .`
# (Without this file gcloud falls back to .gitignore, which would also drop deploy/knowledge/knowledge.db.)
.gcloudignore
.git
.gitignore
**/node_modules/
**/.next/
**/__pycache__/
**/.pytest_cache/
.env
.env.*
!.env.example
mobile/
backend/.data/
backend/.cache/dish_images/
backend/tests/
bcd_tofu_house.png
/sample-menu.png
*.log
