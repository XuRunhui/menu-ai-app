# DeepSeek API Configuration (multimodal, non-thinking mode)
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional overrides
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Places API Configuration (RECOMMENDED)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the Places API (New) in your Google Cloud project
# Requires a billing account. Free monthly caps are per SKU (since March 2025), e.g.
# Place Details 5,000 · Atmosphere Data (reviews/rating) 1,000 · Place Photo 1,000
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Yelp Fusion API Configuration (OPTIONAL - Limited Free Tier)
# Get your API key from: https://www.yelp.com/developers/v3/manage_app
# Note: Free tier does NOT include review text access
# Note: Works for some restaurants, fails for others (expected behavior)
YELP_API_KEY=your_yelp_api_key_here

# Dish photos: let DeepSeek look at the search results and pick the one that really shows the dish.
# Costs roughly $0.0002 per dish, once — the chosen photo is cached for 28 days and shared by
# everyone. Set to false to fall back to "first result that downloads" (free, often wrong).
# DISH_IMAGE_JUDGE_ENABLED=true
# DISH_IMAGE_CANDIDATES=6          # photos shown to the model per dish
# DISH_IMAGE_JUDGE_BATCH_SIZE=6    # images per request (DeepSeek accepts up to 600)

# Accounts (register/login/Google/history on the server). false = guest-only demo, everything works
AUTH_ENABLED=false

# Only used when AUTH_ENABLED=true:
# Auth session signing key (set it, or every backend restart signs everyone out)
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=

# Google sign-in (optional): OAuth 2.0 "Web application" client ID from Google Cloud Console
# Leave empty to hide the "Continue with Google" button
GOOGLE_OAUTH_CLIENT_ID=
